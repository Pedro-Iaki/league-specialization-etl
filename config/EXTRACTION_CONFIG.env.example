# Copy to config/EXTRACTION_CONFIG.env. Process environment values override this file.
# Defaults below apply when a key is omitted; a blank value does not select a default.
# ExtractionConfigManifest validates all collection and job settings before a run.

# Riot API credential (text; required, no default; non-empty valid key).
# Authenticates player/mastery requests; replace this placeholder before collection.
RIOT_API_KEY=your_key_here

# Collection rounds per configured tier/division pair (integer; required; 1..1000).
# Total rounds = depth * number of tiers * number of divisions. Each discovery
# round claims one page from the shared cursor; this does not reset its page number.
# Higher values run longer; rounds may perform only refresh work at the refresh cap.
PLAYERS_FETCH_DEPTH=30

# Missing-mastery players attempted per discovery round (integer; required; 1..1000).
# Lower values leave more local mastery work pending; higher values use more requests.
# This does not limit the separate stale-player refresh allocation.
MASTERY_TASK_LIMIT=400

# Scan raw Parquet files as well as the database before compaction (boolean).
# Default false; true costs more local I/O. Compacted-output checks always run.
# Example opts into the full scan; use true or false.
FULL_VERIFICATION=True

# Riot platform routing code (text; required, no default; non-empty).
# Use a platform supporting the league endpoints, e.g. na1. Selects API routing
# and registry scope; the model does not validate Riot's supported platform list.
REGION=na1

# Ranked queue identifier (text; required, no default; non-empty).
# Use RANKED_SOLO_5x5 or RANKED_FLEX_SR for the paged league endpoint.
# Selects discovery and refresh scope; supported queue names are not model-validated.
QUEUE=RANKED_SOLO_5x5

# Comma-separated discovery tiers (at least one; default is all seven below).
# Allowed: DIAMOND, EMERALD, PLATINUM, GOLD, SILVER, BRONZE, IRON.
# Limits page discovery and changes total rounds; known players outside this list
# can still be refreshed in the configured region/queue. Order breaks page-depth ties.
TIERS=DIAMOND,EMERALD,PLATINUM,GOLD,SILVER,BRONZE,IRON

# Comma-separated discovery divisions (at least one; default I,II,III,IV).
# Allowed: I, II, III, IV. Changes discovery scope and total rounds.
# Order breaks page-depth ties before tier order; refresh is not division-filtered.
DIVISIONS=I,II,III,IV

# Player freshness window (integer minutes; default 10080 = 7 days; minimum 1).
# No configured upper bound. Larger values reduce repeat collection; smaller values
# make observations stale sooner. Used by registry and local awaiting-load filters;
# registry inactivity penalties can defer a stale player's refresh further.
FRESHNESS_THRESHOLD_MINUTES=10080

# Maximum stale-player refreshes per player observed in the latest snapshot.
# Unitless finite multiplier; default 4; strictly greater than 0, no upper bound.
# For a 200-player snapshot, 4 allows up to 800 refreshes (allocation rounds up).
# At this maximum, skip new-player discovery and its mastery fetcher; refresh still runs.
# An empty/skipped snapshot uses the runner's fallback of 205 players (820 refreshes at 4).
# Lower values pause new-player collection sooner; higher values allow more refresh work.
MAX_REFRESH_SCALE=4

# Collection rounds between verification, compaction, ingestion and dbt builds
# (integer rounds; default 10; minimum 1, no upper bound). Final leftovers also load.
# Lower values deliver sooner with more job overhead; higher values retain more
# local work between loads. A value above total rounds loads only at the end.
RUNS_PER_LOAD=10

# Deployed ingestion-only Databricks job ID (integer; required; strictly positive).
# No default or configured upper bound. Replace 0: it intentionally fails validation.
# Python waits for this job before marking files loaded and updating the registry.
INGEST_JOB_ID=0

# Local wait per ingestion job attempt (integer seconds; default 900; minimum 1).
# No configured upper bound. A timeout stops the local pipeline and retains files;
# it does not cancel the remote run. Inspect that run before retrying.
INGESTION_TIMEOUT_SECONDS=900

# Deployed dbt build job ID (integer; required; strictly positive).
# No default or configured upper bound. Replace 0: it intentionally fails validation.
# Runs after confirmed ingestion; choose the separate build job, not ingestion.
DBT_JOB_ID=0

# Local wait per dbt job attempt (integer seconds; default 1800; minimum 1).
# No configured upper bound. A timeout stops locally without cancelling the remote
# run; confirmed ingestion stays recorded and local files are retained.
DBT_TIMEOUT_SECONDS=1800
