# Copy to config/DATABRICKS_CONFIG.env. Process environment values take precedence.
# Text values below have no defaults; blank placeholders must be filled before use.

# Databricks workspace server hostname, without a scheme or path (text).
# Required for SQL connections, file uploads and job API calls; use the hostname
# of the workspace containing the landing volume and deployed jobs.
HOST=

# SQL warehouse HTTP path, e.g. /sql/1.0/warehouses/<warehouse-id> (text).
# Required for SQL operations such as champion loading, exports and live dashboard
# queries; selects the warehouse. Upload/job API calls do not use this setting.
HTTP_PATH=

# Databricks personal access token (secret text; required for authenticated calls).
# Use a valid token with access to the configured warehouse, volumes and jobs.
# No numeric bounds; an expired or insufficiently privileged token stops those calls.
TOKEN=
